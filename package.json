{
	"name": "reikaze-rambles-site",
	"private": true,
	"description": "The new home for RockmanDash Reviews",
	"version": "0.2.0",
	"bugs": {
		"url": "https://github.com/Reikaze/ReikazeRambles/issues"
	},
	"homepage": "https://reikazerambles.com",
	"type": "module",
	"license": "MPL-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Reikaze/ReikazeRambles.git"
	},
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24.16.0"
	},
	"scripts": {
		"debug": "env-cmd -f ./src/environments/debug.env astro dev",
		"dev": "env-cmd -f ./src/environments/dev.env astro dev",
		"start": "astro dev",
		"build": "npm-run-all --parallel social-previews:build && astro build",
		"build:debug": "env-cmd -f ./src/environments/debug.env astro build",
		"build-beta": "env-cmd -f ./src/environments/beta.env pnpm run build",
		"preview": "astro preview",
		"host:local": "cd dist && ws --http2 --compress",
		"format": "prettier --write . --cache",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"social-previews:build": "env-cmd -f ./src/environments/browser-path.env tsx --tsconfig tsconfig.script.json build-scripts/social-previews/index.ts",
		"social-previews:dev:build": "env-cmd -f ./src/environments/browser-path.env tsx watch --tsconfig tsconfig.script.json build-scripts/social-previews/live-server.ts",
		"social-previews:dev:server": "env-cmd -f ./src/environments/browser-path.env live-server build-scripts/social-previews/dist",
		"social-previews:dev": "npm-run-all --parallel social-previews:dev:build social-previews:dev:server",
		"epub": "node --max-old-space-size=16384 --stack-size=65500 ./node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.script.json build-scripts/epubs/generate-epubs.ts",
		"tsc": "astro check && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:debug": "vitest --inspect-brk --no-file-parallelism --test-timeout=0",
		"prepare": "husky && env-cmd -f ./src/environments/browser-path.env playwright install chromium"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/preact": "^6.0.4",
		"@astrojs/sitemap": "^3.7.3",
		"@eslint/js": "10.0.1",
		"@react-types/shared": "3.36.1",
		"@remark-embedder/core": "^3.0.3",
		"@remark-embedder/transformer-oembed": "^5.0.1",
		"@shikijs/rehype": "^4.4.3",
		"@shikijs/transformers": "^4.4.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@types/git-branch": "^2.0.5",
		"@types/hast": "^3.0.5",
		"@types/jest": "^30.0.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.13.3",
		"@typescript-eslint/parser": "^8.68.0",
		"astro": "^7.2.8",
		"astro-icon": "^1.2.0",
		"autoprefixer": "^10.5.4",
		"classnames": "^2.5.1",
		"dayjs": "^1.11.23",
		"env-cmd": "^11.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"eslint-plugin-astro": "^3.1.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"feed": "^6.0.0",
		"git-branch": "^2.0.1",
		"globals": "17.11.0",
		"gray-matter": "^4.0.3",
		"hast-util-from-html": "^2.0.3",
		"hast-util-has-property": "^3.0.0",
		"hast-util-heading-rank": "^3.0.0",
		"hast-util-to-string": "^3.0.1",
		"hastscript": "^9.0.1",
		"husky": "^9.1.7",
		"jsdom": "30.0.1",
		"json5": "^2.2.3",
		"junk": "^4.0.1",
		"kleur": "4.1.5",
		"local-web-server": "5.4.0",
		"npm-run-all": "^4.1.5",
		"plausible-tracker": "^0.3.9",
		"postcss": "^8.5.26",
		"postcss-csso": "^6.0.1",
		"preact-render-to-string": "^6.7.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"rehype-parse": "9.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-slug-custom-id": "^2.0.0",
		"rehype-stringify": "^10.0.1",
		"rehype-unwrap-images": "1.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sass": "^1.103.1",
		"sharp": "^0.35.4",
		"sitemap": "^9.0.1",
		"svgo": "^4.1.0",
		"symlink-dir": "^10.0.1",
		"terser": "^5.51.0",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.68.0",
		"unified": "^11.0.5",
		"unist-util-find": "^3.0.0",
		"unist-util-is": "^6.0.1",
		"unist-util-visit": "^5.1.0",
		"vfile": "^6.0.3",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	},
	"lint-staged": {
		"*.{js,ts,astro}": "eslint --cache --fix",
		"*.{js,ts,astro,jsx}": "prettier --write"
	},
	"dependencies": {
		"medium-zoom": "^1.1.0",
		"preact": "10.29.8",
		"react-aria": "^3.51.0",
		"react-stately": "^3.49.0",
		"uuid": "^14.0.2"
	}
}
